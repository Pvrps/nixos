# Mango (mangowm) Wayland compositor — dwl/wlroots based, with a niri-like
# scroller layout and wp-tearing-control support (uncapped, tearing game
# presentation, which niri cannot do yet).
#
# Mirrors the niri module's shape: other modules contribute startup commands,
# keybinds and rules guarded behind `custom.programs.mango.enable`, and this
# module renders them into ~/.config/mango/config.conf.
#
# Config syntax notes (mango 0.18):
#   - one `key=value` per line; each value is capped at 255 characters, so
#     long commands belong in a script (startupCommands are wrapped into one).
#   - `#` preceded by whitespace starts a comment, even mid-value.
#   - bind=MODS,KEY,DISPATCHER,ARGS   e.g. bind=SUPER+SHIFT,s,spawn,screenshot-tool
#   - window_rule=PARAM:VALUE,...,app_id:REGEX,title:REGEX
{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.custom.programs.mango;

  # One exec_once entry for all startup commands: each runs in the background
  # so a slow command (nm-online waits) never delays the others.
  autostart = pkgs.writeShellScript "mango-autostart" (
    lib.concatMapStrings (cmd: ''
      ( ${cmd} ) &
    '')
    cfg.startupCommands
  );

  terminalBind = lib.optional (cfg.defaultTerminal != null) "SUPER,Return,spawn,${cfg.defaultTerminal}";

  bindLines = map (b: "bind=${b}") (terminalBind ++ cfg.keybinds);

  colors = config.lib.stylix.colors;
  stylixColors = lib.optionalString (config.stylix.enable or false) ''
    root_color=0x${colors.base00}ff
    border_color=0x${colors.base01}ff
    focus_color=0x${colors.base0D}ff
    urgent_color=0x${colors.base08}ff
    maximized_screen_color=0x${colors.base0B}ff
    scratchpad_color=0x${colors.base0E}ff
    global_color=0x${colors.base0C}ff
    overlay_color=0x${colors.base0A}ff
    drop_color=0x${colors.base0D}55
    split_color=0x${colors.base09}ff
  '';

  cursor = lib.optionalString (config.stylix.enable or false) ''
    cursor_theme=${config.stylix.cursor.name}
    cursor_size=${toString config.stylix.cursor.size}
  '';

  configText = ''
    # Generated by home-manager (modules/home/programs/desktop/mango.nix).

    ${stylixColors}
    ${cursor}
    exec_once=${autostart}

    ${cfg.inputConfig}

    ${cfg.outputConfig}

    ${cfg.layoutConfig}

    ${cfg.windowRulesConfig}

    ${cfg.layerRulesConfig}

    ${lib.concatStringsSep "\n" bindLines}
    ${cfg.bindsConfig}

    ${cfg.extraConfig}
  '';

  # Fail the build on config errors instead of at login. `-p` only parses the
  # file (no backend is started), so it runs fine in the sandbox.
  validatedConfig =
    pkgs.runCommand "mango-config.conf" {
      nativeBuildInputs = [cfg.package];
      passAsFile = ["configText"];
      inherit configText;
    } ''
      cp "$configTextPath" "$out"
      export HOME="$TMPDIR" XDG_RUNTIME_DIR="$TMPDIR"
      if ! mango -c "$out" -p > log 2>&1; then
        cat log >&2
        echo "mango config failed to validate" >&2
        exit 1
      fi
      if grep -qiE 'error|invalid|unknown' log; then
        cat log >&2
        echo "mango config validation reported problems" >&2
        exit 1
      fi
    '';
in {
  options.custom.programs.mango = {
    enable = lib.mkEnableOption "Mango Wayland compositor";

    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.mango;
      description = "Mango package used for build-time config validation (match the system's programs.mango.package).";
    };

    defaultTerminal = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      description = "Default terminal command. Auto-binds Super+Return. Use lib.mkDefault to catch conflicts.";
    };

    startupCommands = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = "Shell commands run once at startup (each backgrounded, via a generated autostart script).";
    };

    keybinds = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = ''Bind specs without the `bind=` prefix, e.g. "SUPER+SHIFT,s,spawn,screenshot-tool".'';
    };

    inputConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Raw keyboard/mouse/trackpad settings.";
    };

    outputConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Raw monitor_rule lines.";
    };

    layoutConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Raw layout, gap, animation and effect settings.";
    };

    windowRulesConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Raw window_rule / tag_rule lines.";
    };

    layerRulesConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Raw layer_rule lines.";
    };

    bindsConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Raw bind/mousebind/axisbind lines (with their `bind=` prefixes).";
    };

    extraConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Raw lines appended after all sections.";
    };
  };

  config = lib.mkIf cfg.enable {
    custom.system.wayland.enable = true;

    xdg.configFile."mango/config.conf".source = validatedConfig;

    # mango imports its environment into systemd/dbus at startup and then
    # starts mango-session.target (and stops graphical-session.target on
    # exit). The package ships the unit under share/, where NixOS doesn't pick
    # it up, so define it here; it pulls in graphical-session.target so user
    # services WantedBy it (portals, easyeffects, ...) start.
    systemd.user.targets.mango-session.Unit = {
      Description = "mango compositor session";
      Documentation = ["man:systemd.special(7)"];
      BindsTo = ["graphical-session.target"];
      Wants = ["graphical-session-pre.target"];
      After = ["graphical-session-pre.target"];
    };

    # Screencasting on mango goes through xdg-desktop-portal-wlr, which has no
    # picker of its own: use slurp to choose an output.
    xdg.configFile."xdg-desktop-portal-wlr/config".text = ''
      [screencast]
      chooser_type=simple
      chooser_cmd=${pkgs.slurp}/bin/slurp -f %o -or
    '';

    home.packages = [pkgs.wlr-randr];
  };
}
